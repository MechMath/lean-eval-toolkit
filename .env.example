# Remote model. Any OpenAI-compatible chat-completions endpoint works, including vLLM.
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_API_KEY=
MODEL_NAME=your-model-name
MODEL_TIMEOUT_SECONDS=300
MODEL_MAX_TOKENS=4096
MODEL_TEMPERATURE=0
# Optional JSON objects for provider-specific parameters or headers.
MODEL_EXTRA_BODY={}
MODEL_EXTRA_HEADERS={}

# Axiom Lean Engine (AXLE). API key is optional for endpoints allowing anonymous use.
AXLE_API_URL=https://axle.axiommath.ai
AXLE_API_KEY=
AXLE_ENVIRONMENT=lean-4.32.0
AXLE_TIMEOUT_SECONDS=900

# Evaluation defaults.
EVAL_CONCURRENCY=4
EVAL_ATTEMPTS=1
EVAL_RESULTS_DIR=results
